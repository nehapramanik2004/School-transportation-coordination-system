{
  "name": "school-transport-coordination-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev --workspace backend\" \"npm:dev --workspace frontend\"",
    "start": "concurrently -k -n API,WEB -c blue,green \"npm:start --workspace backend\" \"npm:preview --workspace frontend\"",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8"
  }
}
